NEXT_PUBLIC_MEZO_RPC_URL=

# Archive RPC endpoints for historical state reads (trailing APY windows).
# The default public Mezo nodes prune historical state (~half a day), so
# eth_call at older blocks reverts and the 7d/30d APY windows can't be computed.
# Point these at an archive node to enable them. Optional — when unset, the app
# falls back to the live RPC and longer windows resolve to "no data".
NEXT_PUBLIC_MEZO_ARCHIVE_RPC_URL=https://mezo-mainnet-rpc.blockreq.com/v1/rpc/public

NEXT_PUBLIC_MEZO_ARCHIVE_RPC_URL_TESTNET=https://mezo-testnet-rpc.blockreq.com/v1/rpc/public

