NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Server-only secrets (no NEXT_PUBLIC_ prefix — never shipped to the client) ─

# Goldsky subgraph query endpoints (see /subgraph). Used by the /api/v1 events
# and APY endpoints; those endpoints return 503 when unset.
SUBGRAPH_URL_TESTNET=
SUBGRAPH_URL_MAINNET=

# Keyed mainnet live RPC used by the backend. Falls back to the public keyless
# endpoint when unset.
MEZO_RPC_URL=

# Archive RPC endpoints for historical state reads (trailing APY windows).
# Public Mezo nodes prune historical state (~half a day), so eth_call at older
# blocks reverts and the 7d/30d APY windows can't be computed. Optional — when
# unset, the backend falls back to the live RPC and longer windows resolve to
# "no data".
MEZO_ARCHIVE_RPC_URL=
MEZO_ARCHIVE_RPC_URL_TESTNET=https://mezo-testnet-rpc.blockreq.com/v1/rpc/public

# ── Public configuration (contract addresses — on-chain, public by nature) ────

# ── Testnet (chain id 31611) ─────────────────────────────────────────────────
